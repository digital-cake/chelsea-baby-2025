<div class="section-header__inner{% if template.name == 'index' %} section-header__inner--index{% endif %}">
    <div class="section-header__top">

        <div class="section-header__mobile">
            <button type="button">
                <span class="burger">
                    {% render 'icon-menu.svg' %}
                </span>
                <span class="cross">
                    {% render 'icon-cross.svg' %}
                </span>
            </button>
        </div>

        <div class="section-header__search">
            <button id="header-search-toggle" type="button" aria-label="{{ "search.title" | t }}">
                {% render "icon-search.svg" %}
                <span>{{ "search.placeholder" | t }}</span>
            </button>
        </div>

        <div class="section-header__branding">
            <h1 style="display: none;">{{ page_title }}</h1>
            {% if section.settings.logo != blank %}
                <a aria-label="{{ shop.name }}" href="{{ routes.root_url }}">
                    {% render 'responsive-image', width: 600, source: section.settings.logo.src, alt: section.settings.logo.alt %}
                </a>
            {% endif %}
        </div>

        <div class="section-header__actions">
            <a class="section-header__actions-account" aria-label="{{ 'general.menu.account' | t }}" href="{{ routes.account_url }}">{% render 'icon-account.svg' %}<span>{{ 'general.menu.account' | t }}</span></a>
            <a class="section-header__actions-wishlist" aria-label="{{ 'general.menu.wishlist' | t }}" href="{{ routes.root_url }}pages/wishlist">{% render 'icon-heart.svg' %}<span>{{ 'general.menu.wishlist' | t }}</span></a>
            <button class="section-header__actions-search" id="header-search-toggle" type="button" aria-label="{{ "search.title" | t }}">
                {% render "icon-search.svg" %}
                <span>{{ "search.placeholder" | t }}</span>
            </button>
            <div class="section-header__actions-cart">
                <button aria-label="{{ 'general.menu.cart' | t }}" type="button"><span>{{ 'general.menu.cart' | t }}</span>{% render 'icon-cart.svg' %}</button>
                <span id="cart-counter"><span class="count"></span></span></a>
            </div>
        </div>
    </div>

    <div class="section-header__navigation">
        {% render 'menu-desktop', blocks: section.blocks %}
    </div>
</div>

{% render "drawer-mobile", blocks: section.blocks %}

{% render "drawer-search" %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.facebook_link | json }},
      {{ settings.x_link | json }},
      {{ settings.instagram_link | json }},
      {{ settings.youtube_link | json }},
      {{ settings.pinterest_link | json }},
      {{ settings.tiktok_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

