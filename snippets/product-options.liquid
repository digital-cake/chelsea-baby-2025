{% if product.metafields.cake.product_options != blank %}
    
    {% style %}
        .product-options__item .details__inner-title {
            font-size: {{ section.settings.product_option_title_size }}px;
            {% if section.settings.product_option_title_colour != blank %}
                color: {{ section.settings.product_option_title_colour }};
            {% endif %}
        }
        .product-options__item .price ins {
            font-size: {{ section.settings.product_option_compare_price_size }}px;
            {% if section.settings.product_option_compare_price_colour != blank %}
                color: {{ section.settings.product_option_compare_price_colour }};
            {% endif %}
        }
        .product-options__item .product-options__item .price {
            {% if section.settings.product_option_price_colour != blank %}
                color: {{ section.settings.product_option_price_colour }};
            {% endif %}
        }
        .product-options__item .price del, .product-options__item .compare-was {
            font-size: {{ section.settings.product_option_price_size }}px;
            {% if section.settings.product_option_price_colour != blank %}
                color: {{ section.settings.product_option_price_colour }};
            {% endif %}
        }
    {% endstyle %}
    
    <div class="section-main-product__content-options">
        <span>{{ 'products.product.choose_your_options' | t }}</span>
        {% assign product_options = product.metafields.cake.product_options.value %}
        <ul class="product-options__list">
            {% for product_option in product_options.products.value %}
                {% if product.id != product_option.id %}
                    <li class="product-options__item{% if product.id == product_option.id %} current{% endif %}">
                        <a class="details" aria-label="{{ product_option.title }}" href="{{ product_option.url }}">
                            {% render 'responsive-image', width: 240, source: product_option.images[0].src, alt: product_option.images[0].alt, class: 'media' %}
                            <div class="details__inner">
                                <span class="details__inner-title">{{ product_option.title }}</span>
                                {% if product_option.metafields.cake.product_option_short_description != blank %}
                                    <span class="details__inner-description">{{ product_option.metafields.cake.product_option_short_description }}</span>
                                {% endif %}
                                {% render 'product-price', product: product_option %}
                            </div>
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
{% endif %}