{%- render 'vite' with '@snippetStyles/_menu-desktop.scss' -%}
{%- render 'vite' with '@@/components/menu-desktop.js' -%}

<div>
    <nav>
        <ul class="menu menu-desktop">
        {% for block in section.blocks %}
            {% case block.type %}
                {% when "link" %}
                    <li class="menu-desktop__item menu-desktop__item--link">
                        {% assign highlightLink = false %}
                        {% if block.settings.highlight_link %} 
                            {% assign highlightLink = true %}
                        {% endif %}
                        <a href="{{ block.settings.url }}" {% if highlightLink %} style="background-color:{{ block.settings.highlight_link_bg_color }}"{% endif %} class="menu-desktop__link{% if highlightLink %} menu-desktop__link--highlight{% endif %}" aria-label="{{ block.settings.title }}">
                            <span {% if highlightLink %} style="color:{{ block.settings.highlight_link_text_color }}"{% endif %}>{{ block.settings.title }}</span>
                        </a>
                    </li>
                {% when "mega_2" %}
                    {% render "menu-desktop-mega-2-tier", block: block.settings %}
                {% when "brands" %}
                    {% render "menu-desktop-brands", block: block.settings %}
            {% endcase %}
        {% endfor %}
        </ul>
    </nav>
</div>